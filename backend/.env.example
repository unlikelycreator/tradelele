# ─────────────────────────────────────────────────────────────
#  ZoopTrade Crypto backend configuration (CoinDCX spot + futures)
#  Copy to .env and fill in. Never commit your real .env.
# ─────────────────────────────────────────────────────────────

PORT=4100
# Set to production on your server (enforces a real password and JWT secret)
NODE_ENV=development

# MongoDB (local install, Docker or Atlas).
# MONGO_URI=memory runs without MongoDB, but nothing (journal, paper days, open trades) survives a restart.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=zooptrade_crypto

# Dashboard login. Anyone with this password can pause/resume the bot and close positions.
DASHBOARD_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# ── Trading mode ────────────────────────────────────────────
# paper = real CoinDCX prices, simulated fills (no real orders, no API keys needed)
# live  = REAL orders on your CoinDCX account
TRADING_MODE=paper
# Live mode is refused unless this is set exactly as below…
LIVE_TRADING_CONFIRM=
# …and the bot has completed at least this many paper-trading days (an IST day counts once the bot ran ≥ 20 h of it).
MIN_PAPER_DAYS=7

# Where prices come from:
# coindcx = real CoinDCX public market data
# sim     = synthetic random prices, accelerated (demo / UI testing only — results mean nothing)
DATA_SOURCE=coindcx
# Simulator speed (sim only): 10 = a 15-minute candle every 90 seconds
SIM_SPEED=10

# ── CoinDCX API (only needed for live trading and the account panel) ──
# Create at coindcx.com → Settings → API Dashboard. Enable trading, NEVER enable withdrawals,
# and bind the key to your server's IP address if CoinDCX offers it.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ── Capital (USDT; can also be changed from the dashboard) ──
CAPITAL=100

# ── Gemini (optional) ───────────────────────────────────────
# Used ONLY for the end-of-day trade review / journal. It never places or blocks trades.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
